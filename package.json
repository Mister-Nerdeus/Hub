{
  "name": "nerdeus-er-pod-shift-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Operational ER pod shift simulator workspace.",
  "workspaces": [
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "check:dependencies": "node scripts/check-dependency-specs.mjs",
    "check:docs": "node scripts/check-docs-contracts.mjs",
    "check:no-phi": "node scripts/check-no-phi-fields.mjs",
    "check:production-docker-runtime": "node scripts/check-production-docker-runtime.mjs",
    "check:plan1-visual-parity": "npm --workspace packages/shared run build && node scripts/check-plan-1-visual-parity.mjs --stage final",
    "check:plans-2-5-unchanged": "node scripts/check-default-plans-2-through-5-unchanged.mjs",
    "evidence:local": "node scripts/generate-local-evidence-pack.mjs",
    "evidence:local:tracked": "npm run evidence:local -- --tracked",
    "validate:plan": "npm --workspace @nerdeus/shared run build && node scripts/validate-plan-contract.mjs",
    "verify": "node scripts/verify-local.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
