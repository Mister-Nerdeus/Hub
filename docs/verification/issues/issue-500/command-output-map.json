{
  "issue": "500",
  "commands": [
    {
      "command": "npm --workspace packages/shared test",
      "outputs": [
        "docs/verification/issues/issue-500/test-output/shared.txt"
      ]
    },
    {
      "command": "npm --workspace apps/web test",
      "outputs": [
        "docs/verification/issues/issue-500/test-output/web.txt"
      ]
    },
    {
      "command": "npm --workspace apps/web run build",
      "outputs": [
        "docs/verification/issues/issue-500/test-output/web-build.txt"
      ]
    },
    {
      "command": "node scripts/check-access-code-no-leak.mjs --stage final --issue 500",
      "outputs": [
        "docs/verification/issues/issue-500/test-output/access-code-no-leak.txt"
      ]
    },
    {
      "command": "node scripts/check-no-phi-fields.mjs",
      "outputs": [
        "docs/verification/issues/issue-500/test-output/no-phi.txt"
      ]
    }
  ]
}
