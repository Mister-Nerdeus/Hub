FROM node:22-alpine AS build

WORKDIR /repo

ARG VITE_API_BASE_URL=
ARG VITE_BUILD_COMMIT=local-dev
ARG VITE_BUILD_TIME=local-build
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_BUILD_COMMIT=${VITE_BUILD_COMMIT}
ENV VITE_BUILD_TIME=${VITE_BUILD_TIME}

COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci

COPY tsconfig.base.json ./
COPY apps/web apps/web
COPY packages/shared packages/shared

RUN npm --workspace apps/web run build

FROM nginx:1.27-alpine

LABEL org.opencontainers.image.title="ER Pod Shift Simulator"
LABEL org.opencontainers.image.description="Operational simulation tool; no PHI or EHR integration"
LABEL org.opencontainers.image.revision="door-authoring-crash-hardening-669-678"

COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
COPY apps/web/nginx.production.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
